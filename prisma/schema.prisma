generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlanKey {
  FREE
  PRO
  TEAM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum MediaType {
  BOOK
  MOVIE
  TV_SHOW
  OTHER
}

enum MediaStatus {
  BACKLOG
  IN_PROGRESS
  COMPLETED
  DROPPED
}

enum GoalStatus {
  PLANNED
  ACTIVE
  DONE
  CARRIED_FORWARD
  ARCHIVED
}

enum ReminderChannel {
  EMAIL
  PUSH
  IN_APP
}

enum HealthActivityType {
  GYM
  RUN
  WALK
  CYCLE
  SWIM
  OTHER
}

model User {
  id                String              @id @default(cuid())
  cognitoSubject    String?             @unique
  email             String              @unique
  displayName       String?
  timezone          String              @default("Australia/Sydney")
  currency          String              @default("AUD")
  onboardingDone    Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  mediaEntries      MediaEntry[]
  accounts          Account[]
  categories        TransactionCategory[]
  budgets           Budget[]
  transactions      Transaction[]
  recurringItems    RecurringTransaction[]
  weeklyGoals       WeeklyGoal[]
  habits            Habit[]
  habitLogs         HabitLog[]
  learningTopics    LearningTopic[]
  learningResources LearningResource[]
  studySessions     StudySession[]
  healthActivities  HealthActivity[]
  reminders         Reminder[]
  notes             Note[]
  subscriptions     Subscription[]
}

model Plan {
  id            String         @id @default(cuid())
  key           PlanKey        @unique
  name          String
  description   String?
  monthlyPrice  Int            @default(0)
  yearlyPrice   Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  entitlements  Entitlement[]
  subscriptions Subscription[]
}

model Entitlement {
  id        String   @id @default(cuid())
  planId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String
  planId            String
  status            SubscriptionStatus @default(TRIALING)
  provider          String?
  providerRef       String?
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              Plan               @relation(fields: [planId], references: [id])
}

model MediaEntry {
  id            String      @id @default(cuid())
  userId        String
  type          MediaType
  title         String
  creator       String?
  status        MediaStatus @default(BACKLOG)
  rating        Int?
  startedOn     DateTime?
  completedOn   DateTime?
  notesSummary  String?
  coverImageUrl String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags          MediaTag[]
  notes         Note[]

  @@index([userId, type, status])
}

model MediaTag {
  id        String    @id @default(cuid())
  mediaId   String
  label     String
  createdAt DateTime  @default(now())
  media     MediaEntry @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, label])
}

model Account {
  id           String        @id @default(cuid())
  userId       String
  name         String
  kind         String
  balance      Decimal       @db.Decimal(12, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgets      Budget[]
  transactions Transaction[]

  @@index([userId, kind])
}

model TransactionCategory {
  id           String        @id @default(cuid())
  userId       String
  name         String
  group        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name])
}

model Transaction {
  id          String               @id @default(cuid())
  userId      String
  accountId   String?
  categoryId  String?
  amount      Decimal              @db.Decimal(12, 2)
  description String
  merchant    String?
  happenedAt  DateTime
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account?             @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category    TransactionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, happenedAt])
}

model Budget {
  id         String               @id @default(cuid())
  userId     String
  categoryId String?
  accountId  String?
  name       String
  amount     Decimal              @db.Decimal(12, 2)
  month      Int
  year       Int
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   TransactionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account    Account?             @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, year, month])
}

model RecurringTransaction {
  id          String   @id @default(cuid())
  userId      String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  cadence     String
  nextRunAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeeklyGoal {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  weekStart   DateTime
  dueAt       DateTime?
  status      GoalStatus @default(PLANNED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Habit {
  id          String     @id @default(cuid())
  userId      String
  title       String
  cadence     String
  streakCount Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs        HabitLog[]
}

model HabitLog {
  id        String   @id @default(cuid())
  userId    String
  habitId   String
  loggedFor DateTime
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, loggedFor])
}

model LearningTopic {
  id          String             @id @default(cuid())
  userId      String
  title       String
  description String?
  progressPct Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  resources   LearningResource[]
  sessions    StudySession[]
}

model LearningResource {
  id        String         @id @default(cuid())
  userId    String
  topicId   String?
  title     String
  kind      String
  url       String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     LearningTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
}

model StudySession {
  id          String         @id @default(cuid())
  userId      String
  topicId     String?
  title       String
  durationMin Int
  happenedAt  DateTime
  summary     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic       LearningTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
}

model HealthActivity {
  id           String             @id @default(cuid())
  userId       String
  type         HealthActivityType
  title        String
  durationMin  Int
  distanceKm   Decimal?           @db.Decimal(8, 2)
  notes        String?
  happenedAt   DateTime
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, happenedAt])
}

model Reminder {
  id        String          @id @default(cuid())
  userId    String
  title     String
  remindAt  DateTime
  channel   ReminderChannel
  completed Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, remindAt])
}

model Note {
  id        String      @id @default(cuid())
  userId    String
  mediaId   String?
  title     String
  body      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     MediaEntry? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
}
